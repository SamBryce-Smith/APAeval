"""
Snakemake pipeline for APAlyzer.
For help see: https://snakemake.readthedocs.io/en/stable/index.html.
"""

import os
import sys


LOG_DIR = os.path.join(config["out_dir"], config["logs_subdir"],"")

# Basename (without extension) of the merged differential challenge output file. Used to
# derive the names of the per-branch (3'UTR only / IPA only) output files.
OUT_STEM = os.path.splitext(config["differential_output_file"])[0]

#-------------------------------------------------------------------------------
# Check run mode params
#-------------------------------------------------------------------------------
assert isinstance(config["run_identification"], bool), f"'run_identification' must be True/False boolean, {config['run_identification']} (type {type(config['run_identification'])}) was provided"
assert isinstance(config["run_quantification"], bool), f"'run_quantification' must be True/False boolean, {config['run_quantification']} (type {type(config['run_quantification'])}) was provided"
assert isinstance(config["run_differential"], bool), f"'run_differential' must be True/False boolean, {config['run_differential']} (type {type(config['run_differential'])}) was provided"

def flag_info_message(flag_name, challenge_name):

    if config[flag_name]:
        sys.stderr.write(f"config['{flag_name}'] set to True - {challenge_name} challenge output to be generated\n")

    elif not config[flag_name]:
        sys.stderr.write(f"config['{flag_name}'] set to False - {challenge_name} challenge output will not be generated. Is this desired run mode?\n")


# Info messages
flag_info_message("run_identification", "identification")
flag_info_message("run_quantification", "quantification")
flag_info_message("run_differential", "differential")

if config["run_identification"] is not False:
    raise ValueError("'run_identification' must be set to False as tool is incompatible with the identification challenge/does not perform this task (see README for details).")

if config["run_quantification"] is not False:
    raise ValueError("'run_quantification' must be set to False as tool is incompatible with the quantification challenge/does not perform this task (see README for details).")

if config["run_differential"] is not True:
    raise ValueError("'run_differential' must be set to True as tool is only compatible with the differential challenge.")


#-------------------------------------------------------------------------------
# Check precomputed input params
#-------------------------------------------------------------------------------
def check_precomputed(flag_name, path_name, description):
    """
    Validate a 'use_precomputed_*' boolean flag and, when set, its companion path key
    """

    assert isinstance(config[flag_name], bool), f"'{flag_name}' must be True/False boolean, {config[flag_name]} (type {type(config[flag_name])}) was provided"

    if config[flag_name]:
        if not config[path_name]:
            raise ValueError(f"'{flag_name}' is set to True, so '{path_name}' must be set to the path of a precomputed {description}")

        if not os.path.exists(config[path_name]):
            raise ValueError(f"'{path_name}' was set to '{config[path_name]}', but no such file exists")

        sys.stderr.write(f"config['{flag_name}'] set to True - precomputed {description} will be read from '{config[path_name]}'\n")


check_precomputed("use_precomputed_gene_dict",
                  "precomputed_gene_dict",
                  "gene_name,gene_id CSV file")

check_precomputed("use_precomputed_pas_reference",
                  "precomputed_pas_reference",
                  "PAS reference regions RData file")

if config["ipa_seq_type"] not in ("SingleEnd", "ThreeMostPairEnd"):
    raise ValueError(f"'ipa_seq_type' must be one of 'SingleEnd' or 'ThreeMostPairEnd', '{config['ipa_seq_type']}' was provided")


#-------------------------------------------------------------------------------
# Input functions for optionally precomputed files
#-------------------------------------------------------------------------------
def get_gene_dict_input(wildcards):
    """
    Path to the precomputed gene_name,gene_id CSV file, or no input if it is to be generated
    """

    if config["use_precomputed_gene_dict"]:
        return config["precomputed_gene_dict"]

    return []


def get_pas_reference_input(wildcards):
    """
    Path to the precomputed PAS reference RData file, or the file generated by 'pas_reference'
    """

    if config["use_precomputed_pas_reference"]:
        return config["precomputed_pas_reference"]

    return os.path.join(config["out_dir"], "pas_reference.RData")


#-------------------------------------------------------------------------------
localrules: finish


rule finish:
    """
    Rule that specifies the final output.
    """
    input:
        merged = os.path.join(config["out_dir"], config["differential_output_file"]),
        utr3 = os.path.join(config["out_dir"], OUT_STEM + ".3utr.tsv"),
        ipa = os.path.join(config["out_dir"], OUT_STEM + ".ipa.tsv")


include: "rules/preprocessing.smk"
include: "rules/main.smk"
include: "rules/postprocessing.smk"

#-------------------------------------------------------------------------------
# How did it go?
#-------------------------------------------------------------------------------
onsuccess:
    print("Workflow finished, no error")

onerror:
    print("An error occurred, check log at %s." % {log})
